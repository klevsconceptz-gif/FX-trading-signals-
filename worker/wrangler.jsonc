{
  "name": "fx-trading-signals",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "hidden-tree-8340.cloudflareaccess.com",
    "CF_ACCESS_AUD": "1e651a239749cced021f5b1ea2e4abe106fd7b6d4c73323cb67b983682800fb0"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "klev",
      "database_id": "34b258e8-4342-4b5a-9299-a9c8962e1dda",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "7f97e85c48914f399343741ff876099f"
    }
  ]
}
