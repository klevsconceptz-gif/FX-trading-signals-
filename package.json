{
  "name": "klevs-fx-signals-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "mobile:sync": "npm run build:mobile && cap sync",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:test": "node --test worker/test/*.test.js",
    "e2e:admin": "node scripts/e2e/admin-e2e.mjs",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:migrate:local": "wrangler d1 migrations apply klev --local --config worker/wrangler.jsonc",
    "worker:migrate:remote": "wrangler d1 migrations apply klev --remote --config worker/wrangler.jsonc",
    "cloudflare:bootstrap": "node scripts/cloudflare_bootstrap.mjs",
    "cloudflare:bootstrap:test": "node --test scripts/test/*.test.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3"
  }
}
