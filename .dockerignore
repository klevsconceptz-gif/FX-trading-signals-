# Keep the build context small and keep secrets, local data and VCS metadata out of the image.
.git
.gitignore
.venv
venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
tests
scripts
docs
deploy
edge
worker
functions
node_modules
dist
output
models
data
