{
  // Cloudflare Worker that fronts the KLEVS container.
  // Deploy with: npm run deploy (from edge/). Secrets: see edge/README.md and docs/CLOUDFLARE_DEPLOYMENT.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klevs-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // Placeholder hostname. Replace with your zone's hostname before deploying.
  "routes": [{ "pattern": "klevs.example.com", "custom_domain": true }],
  "observability": { "enabled": true },
  // SQLite snapshots: key klevs/klevs.db. Create the bucket first: wrangler r2 bucket create klevs-backups
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "klevs-backups" }],
  // Cloudflare Email Service. The sender domain must be onboarded in the dashboard first.
  "send_email": [{ "name": "EMAIL" }],
  "containers": [
    {
      "class_name": "KlevsContainer",
      // Build context is the repository root, so the Dockerfile's COPY lines resolve from there.
      "image": "../Dockerfile",
      // Provisional size: 1 vCPU and 6 GiB. Confirm against the model's memory use before going live.
      "instance_type": "standard-2",
      // One instance only: the SQLite file has one writer.
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "KLEVS_CONTAINER", "class_name": "KlevsContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KlevsContainer"] }],
  "vars": {
    "KLEVS_PUBLIC_ORIGIN": "https://klevs.example.com",
    "KLEVS_MAIL_FROM": "noreply@klevs.example.com"
  }
}
