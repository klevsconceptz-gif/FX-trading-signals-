{
  "name": "klevs-edge",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that fronts the KLEVS container, its R2 snapshot route and its e-mail relay.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.json && node --test .build/test/*.test.js",
    "dev": "wrangler dev --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:dry-run": "wrangler deploy --config wrangler.jsonc --dry-run --outdir .wrangler-out"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "wrangler": "4.152.0"
  }
}
