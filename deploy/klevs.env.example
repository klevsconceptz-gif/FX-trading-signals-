# Environment for the KLEVS app. Copy to /etc/klevs/klevs.env (VM + systemd)
# or pass with `docker run --env-file` (Docker). Keep the real file out of Git.
# Lines starting with # are comments. Leave a value empty to use the default.

# --- Operator database --------------------------------------------------------
# PostgreSQL is recommended in production. Unset = SQLite at data/klevs.db,
# which is fine for a single-node trial but needs a persistent volume.
# Use a dedicated role with access to this database only. Keep sslmode=require
# when the database is on another host.
KLEVS_DATABASE_URL=postgresql+psycopg://klevs:CHANGE_ME@db.internal:5432/klevs?sslmode=require

# --- Bootstrap admin ------------------------------------------------------------
# On EVERY start the app sets the admin's password to KFX_ADMIN_PASSWORD (and clears
# any login lockout). So the value here is authoritative: to rotate the admin password,
# change it here and restart. A password left in this file wins on each restart.
# Use a long random password. Never reuse the one that appeared in an earlier commit.
KFX_ADMIN_USERNAME=
KFX_ADMIN_PASSWORD=
KFX_ADMIN_EMAIL=
KFX_ADMIN_PHONE=

# --- Market data ---------------------------------------------------------------
# 1 = live hourly bars from Yahoo Finance (needs the yfinance install, the default image has it).
# 0 = synthetic market only.
KFX_LIVE_DATA=1

# --- Outgoing email (verification and reset codes) -----------------------------
KLEVS_SMTP_HOST=
KLEVS_SMTP_PORT=587
KLEVS_SMTP_USER=
KLEVS_SMTP_PASSWORD=
KLEVS_SMTP_FROM=

# --- Development only: NEVER set in production ---------------------------------
# Shows reset/verification codes in responses instead of sending them.
# Leave unset or empty in production.
KLEVS_DEV_RESET_CODES=
