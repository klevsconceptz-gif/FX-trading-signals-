# systemd unit for running the app directly on a VM (no Docker).
# Install:
#   sudo useradd --system --home /opt/klevs --shell /usr/sbin/nologin klevs
#   sudo install -d -o klevs -g klevs /opt/klevs /opt/klevs/data /opt/klevs/models
#   (copy the repo to /opt/klevs, then in /opt/klevs: python3.11 -m venv .venv &&
#    .venv/bin/pip install -r requirements.txt -r requirements-live.txt "psycopg[binary]>=3.1")
#   sudo install -d -m 0750 -o root -g klevs /etc/klevs
#   sudo install -m 0640 -o root -g klevs deploy/klevs.env.example /etc/klevs/klevs.env   # then edit
#   sudo cp deploy/klevs.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now klevs
#
# It binds to 127.0.0.1 only. cloudflared on the same host reaches it at http://localhost:8000.

[Unit]
Description=KLEVS FX signals app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=klevs
Group=klevs
WorkingDirectory=/opt/klevs
EnvironmentFile=/etc/klevs/klevs.env
ExecStart=/opt/klevs/.venv/bin/uvicorn fxbot.server:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5s

# Hardening. The app only needs to write its data and model directories.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/klevs/data /opt/klevs/models
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
