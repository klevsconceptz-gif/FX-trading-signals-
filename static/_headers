# Cloudflare Pages response headers. Copied to the site root by scripts/build-static.mjs.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Fingerprinted CSS, JS and fonts: the name changes with the content, so the copy can be kept for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Other static files (images, manifest) keep their names, so their cache is short.
/static/*
  Cache-Control: public, max-age=3600
